{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/CoderLambert/ai-parallel/main/apps/browser-extension/schemas/prompt-template-package.schema.json",
  "title": "AI Parallel Prompt Template Package",
  "description": "A portable package containing one or more AI Parallel prompt templates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "templates"],
  "properties": {
    "kind": { "const": "ai-parallel.prompt-template-package" },
    "schemaVersion": { "const": 1 },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/template" }
    }
  },
  "$defs": {
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schemaVersion",
        "id",
        "version",
        "name",
        "categoryId",
        "description",
        "promptTemplate",
        "inputSchema",
        "output"
      ],
      "properties": {
        "$schema": { "type": "string" },
        "kind": { "const": "ai-parallel.prompt-template" },
        "schemaVersion": { "const": 1 },
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,95}$" },
        "version": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "categoryId": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,31}$" },
        "description": { "type": "string", "maxLength": 500 },
        "tags": { "type": "array", "items": { "type": "string" }, "maxItems": 20 },
        "promptTemplate": { "type": "string", "minLength": 1 },
        "inputSchema": { "type": "object" },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "enum": ["text", "json"] },
            "schema": { "type": "object" }
          }
        },
        "metadata": { "type": "object" }
      }
    }
  }
}
